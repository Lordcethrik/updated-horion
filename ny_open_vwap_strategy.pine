// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("NY Open VWAP Strategy Indicator", "NY VWAP", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
// Concept
//   1. Anchor a VWAP at the NY cash open (09:30 ET).
//   2. Let the Opening Range (first 15 or 30 min) form.
//   3. During the Setup Window after the OR, look for price to pull back into
//      the NY VWAP and get rejected (bounce) in the direction of the OR break.
//   4. Plot entry / stop / target boxes and a multi-ticker confluence table.
// ─────────────────────────────────────────────────────────────────────────────

const string TZ = "America/New_York"

// ── Session ──────────────────────────────────────────────────────────────────
grpS      = "Session"
orMins    = input.int(30, "Opening Range Length (min)", options = [15, 30], group = grpS)
setupMins = input.int(90, "Setup Window Length (min)", minval = 5, group = grpS, tooltip = "How long after the Opening Range closes that VWAP bounce signals are allowed.")
nySess    = input.session("0930-1600", "NY Session (ET)", group = grpS)
onSess    = input.session("1800-0930", "Overnight Session (ET)", group = grpS)

// ── Signal ───────────────────────────────────────────────────────────────────
grpSig      = "Signal Rules"
touchTicks  = input.int(4, "VWAP Touch Tolerance (ticks)", minval = 0, group = grpSig, tooltip = "Price must come within this many ticks of the NY VWAP to count as a touch.")
minAway     = input.int(3, "Min Bars Away Before Touch", minval = 1, group = grpSig, tooltip = "Number of bars that must be fully on one side of VWAP right before the pullback touch.")
needCandle  = input.bool(true, "Require Rejection Candle", group = grpSig, tooltip = "Sell needs a red candle, buy needs a green candle on the touch bar.")
needOrBreak = input.bool(true, "Require OR Breakout In Trade Direction", group = grpSig)
needTrend   = input.bool(false, "Require Chart Trend Alignment", group = grpSig)
needBasket  = input.bool(false, "Require All Table Tickers To Agree", group = grpSig)
maxTrades   = input.int(1, "Max Signals Per Session", minval = 1, group = grpSig)

// ── Risk ─────────────────────────────────────────────────────────────────────
grpR       = "Trade Boxes"
showTrades = input.bool(true, "Show Entry / Stop / Target Boxes", group = grpR)
stopTicks  = input.int(8, "Stop Buffer Beyond Signal Candle / VWAP (ticks)", minval = 0, group = grpR)
rr         = input.float(2.0, "Reward : Risk", minval = 0.25, step = 0.25, group = grpR)

// ── Visuals ──────────────────────────────────────────────────────────────────
grpV      = "Visuals"
showNy    = input.bool(true, "NY VWAP", inline = "ny", group = grpV)
nyCol     = input.color(#5B9CF6, "", inline = "ny", group = grpV)
showOn    = input.bool(false, "Overnight VWAP", inline = "on", group = grpV)
onCol     = input.color(#B388FF, "", inline = "on", group = grpV)
showPd    = input.bool(false, "Prev Day NY VWAP", inline = "pd", group = grpV)
pdCol     = input.color(#FFB74D, "", inline = "pd", group = grpV)
showFill  = input.bool(true, "Price / VWAP Fill", group = grpV)
showOrBg  = input.bool(true, "Shade Opening Range", group = grpV)
showOrLn  = input.bool(true, "Opening Range High / Low Lines", group = grpV)
showWin   = input.bool(true, "Setup Window Box", group = grpV)
bullCol   = input.color(#26A69A, "Bull Color", group = grpV)
bearCol   = input.color(#EF5350, "Bear Color", group = grpV)

// ── Table ────────────────────────────────────────────────────────────────────
grpT     = "Confluence Table"
showTbl  = input.bool(true, "Show Table", group = grpT)
tblPos   = input.string("Bottom Right", "Position", options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right", "Bottom Center"], group = grpT)
tblSize  = input.string("Normal", "Text Size", options = ["Tiny", "Small", "Normal", "Large"], group = grpT)
sym1     = input.symbol("CME_MINI:MES1!", "Ticker 1", group = grpT)
sym2     = input.symbol("CME_MINI:MNQ1!", "Ticker 2", group = grpT)
sym3     = input.symbol("CBOT_MINI:MYM1!", "Ticker 3", group = grpT)

// ─────────────────────────────────────────────────────────────────────────────
// Core calculations (written as a function so the same logic runs on the chart
// symbol and on every ticker in the table via request.security).
// ─────────────────────────────────────────────────────────────────────────────
f_core() =>
    bool inNY    = not na(time(timeframe.period, nySess, TZ))
    bool inON    = not na(time(timeframe.period, onSess, TZ))
    bool nyStart = inNY and not inNY[1]
    bool onStart = inON and not inON[1]

    // NY session VWAP, anchored at the 09:30 open
    float nyVwap = ta.vwap(hlc3, nyStart)

    // Overnight VWAP: runs 18:00 → 09:30, then held flat through the day
    float onRun = ta.vwap(hlc3, onStart)
    var float onVwap = na
    if inON
        onVwap := onRun

    // Previous day's final NY session VWAP
    var float lastNy = na
    var float pdVwap = na
    if nyStart
        pdVwap := lastNy
    if inNY
        lastNy := nyVwap

    // Opening range
    var int   openT = na
    var float orH   = na
    var float orL   = na
    if nyStart
        openT := time
        orH   := high
        orL   := low
    int  orEndT = na(openT) ? na : openT + orMins * 60000
    bool inOR   = inNY and not na(orEndT) and time < orEndT
    orH := inOR and not nyStart ? math.max(orH, high) : orH
    orL := inOR and not nyStart ? math.min(orL, low) : orL
    bool orDone = inNY and not na(orEndT) and time >= orEndT

    [inNY, nyStart, nyVwap, onVwap, pdVwap, orH, orL, inOR, orDone, openT]

f_side(float lvl) =>
    na(lvl) ? 0 : close > lvl ? 1 : close < lvl ? -1 : 0

f_state() =>
    [_inNY, _nyStart, _ny, _on, _pd, _orH, _orL, _inOR, _orDone, _openT] = f_core()
    int sNy = f_side(_ny)
    int sOn = f_side(_on)
    int sPd = f_side(_pd)
    int sOr = not _orDone ? 0 : close > _orH ? 1 : close < _orL ? -1 : 0
    [sNy, sOn, sPd, sOr, _orDone]

f_trendTxt(int score) =>
    score >= 3 ? "Strong Up" : score >= 1 ? "Up" : score <= -3 ? "Strong Down" : score <= -1 ? "Down" : "Neutral"

// ── Chart symbol ─────────────────────────────────────────────────────────────
[inNY, nyStart, nyVwap, onVwap, pdVwap, orH, orL, inOR, orDone, openT] = f_core()
[cNy, cOn, cPd, cOr, cOrDone] = f_state()
int cTrend = cNy + cOn + cPd + cOr

// ── Table tickers ────────────────────────────────────────────────────────────
[aNy, aOn, aPd, aOr, aOrDone] = request.security(sym1, timeframe.period, f_state())
[bNy, bOn, bPd, bOr, bOrDone] = request.security(sym2, timeframe.period, f_state())
[dNy, dOn, dPd, dOr, dOrDone] = request.security(sym3, timeframe.period, f_state())
int aTrend = aNy + aOn + aPd + aOr
int bTrend = bNy + bOn + bPd + bOr
int dTrend = dNy + dOn + dPd + dOr

// ─────────────────────────────────────────────────────────────────────────────
// Plots
// ─────────────────────────────────────────────────────────────────────────────
pNy    = plot(showNy and inNY ? nyVwap : na, "NY VWAP", nyCol, 2, plot.style_linebr)
pPrice = plot(showFill and inNY ? close : na, "Price (fill)", display = display.none)
fill(pPrice, pNy, color = close < nyVwap ? color.new(bearCol, 85) : color.new(bullCol, 85), title = "Price / VWAP Fill")
plot(showOn ? onVwap : na, "Overnight VWAP", onCol, 1, plot.style_linebr)
plot(showPd and inNY ? pdVwap : na, "Prev Day NY VWAP", pdCol, 1, plot.style_linebr)
bgcolor(showOrBg and inOR ? color.new(nyCol, 88) : na, title = "Opening Range")

// Opening range lines + setup window box
int winStartT = na(openT) ? na : openT + orMins * 60000
int winEndT   = na(winStartT) ? na : winStartT + setupMins * 60000
bool inWindow = orDone and time < winEndT
bool orJustDone = orDone and not orDone[1]

var line orHiLn = na
var line orLoLn = na
var box  winBox = na
if orJustDone
    if showOrLn
        orHiLn := line.new(openT, orH, time, orH, xloc.bar_time, color = color.new(color.gray, 20), width = 1)
        orLoLn := line.new(openT, orL, time, orL, xloc.bar_time, color = color.new(color.gray, 20), width = 1)
    if showWin
        winBox := box.new(time, high, winEndT, low, xloc = xloc.bar_time, border_color = color.new(color.gray, 50), border_style = line.style_dashed, bgcolor = color.new(color.gray, 94), text = "Setup Window", text_size = size.tiny, text_color = color.new(color.gray, 30), text_valign = text.align_top)
if inNY and not orJustDone
    if not na(orHiLn)
        line.set_x2(orHiLn, time)
        line.set_x2(orLoLn, time)
if inWindow and not orJustDone and not na(winBox)
    box.set_top(winBox, math.max(box.get_top(winBox), high))
    box.set_bottom(winBox, math.min(box.get_bottom(winBox), low))
if nyStart
    orHiLn := na
    orLoLn := na
    winBox := na

// ─────────────────────────────────────────────────────────────────────────────
// Signal logic
// ─────────────────────────────────────────────────────────────────────────────
float tol = touchTicks * syminfo.mintick

// Latest side of the opening range price has closed on (+1 above / -1 below)
var int orBias = 0
var int tradesToday = 0
if nyStart
    orBias      := 0
    tradesToday := 0
if orDone
    orBias := close > orH ? 1 : close < orL ? -1 : orBias

// Price must have been clearly away from VWAP for `minAway` bars before the touch
bool wasBelow = math.sum(high < nyVwap - tol ? 1 : 0, minAway)[1] == minAway
bool wasAbove = math.sum(low  > nyVwap + tol ? 1 : 0, minAway)[1] == minAway

bool touchFromBelow = high >= nyVwap - tol and close < nyVwap
bool touchFromAbove = low  <= nyVwap + tol and close > nyVwap

bool basketDn = aTrend < 0 and bTrend < 0 and dTrend < 0
bool basketUp = aTrend > 0 and bTrend > 0 and dTrend > 0

var int   tDir     = 0
var int   tBar     = na
var float tEntry   = na
var float tStop    = na
var float tTarget  = na
var box   slBox    = na
var box   tpBox    = na
var int   wins     = 0
var int   losses   = 0

bool canTrade = inWindow and tDir == 0 and tradesToday < maxTrades and barstate.isconfirmed

bool sellSig = canTrade and touchFromBelow and wasBelow and (not needCandle or close < open) and (not needOrBreak or orBias == -1) and (not needTrend or cTrend < 0) and (not needBasket or basketDn)

bool buySig = canTrade and touchFromAbove and wasAbove and (not needCandle or close > open) and (not needOrBreak or orBias == 1) and (not needTrend or cTrend > 0) and (not needBasket or basketUp)

// ── Manage open trade ────────────────────────────────────────────────────────
if tDir != 0 and bar_index > tBar
    if not na(slBox)
        box.set_right(slBox, bar_index)
        box.set_right(tpBox, bar_index)
    bool hitSL = tDir == 1 ? low <= tStop : high >= tStop
    bool hitTP = tDir == 1 ? high >= tTarget : low <= tTarget
    if hitSL or hitTP or not inNY
        string res = ""
        color  rc  = na
        if hitSL      // if both hit on the same bar, assume the stop was hit first
            res    := "SL"
            rc     := bearCol
            losses += 1
        else if hitTP
            res  := "TP"
            rc   := bullCol
            wins += 1
        else
            float pnl = (close - tEntry) * tDir
            res := "EOD " + str.tostring(pnl, format.mintick)
            rc  := pnl >= 0 ? bullCol : bearCol
        if showTrades
            label.new(bar_index, tDir == 1 ? high : low, res, style = tDir == 1 ? label.style_label_down : label.style_label_up, color = color.new(rc, 30), textcolor = color.white, size = size.tiny)
        tDir := 0

// ── New signals ──────────────────────────────────────────────────────────────
if sellSig or buySig
    tDir        := sellSig ? -1 : 1
    tBar        := bar_index
    tEntry      := close
    tStop       := sellSig ? math.max(high, nyVwap) + stopTicks * syminfo.mintick : math.min(low, nyVwap) - stopTicks * syminfo.mintick
    float risk   = math.abs(tEntry - tStop)
    tTarget     := tEntry - tDir * rr * risk
    tradesToday += 1
    label.new(bar_index, sellSig ? high : low, sellSig ? "SELL" : "BUY", style = sellSig ? label.style_label_down : label.style_label_up, color = sellSig ? bearCol : bullCol, textcolor = color.white, size = size.small)
    if showTrades
        slBox := box.new(bar_index, math.max(tEntry, tStop), bar_index + 1, math.min(tEntry, tStop), border_color = color.new(bearCol, 60), bgcolor = color.new(bearCol, 80))
        tpBox := box.new(bar_index, math.max(tEntry, tTarget), bar_index + 1, math.min(tEntry, tTarget), border_color = color.new(bullCol, 60), bgcolor = color.new(bullCol, 82))

// ── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(sellSig, "NY VWAP Sell", "NY VWAP bounce SELL on {{ticker}} @ {{close}}")
alertcondition(buySig,  "NY VWAP Buy",  "NY VWAP bounce BUY on {{ticker}} @ {{close}}")
if sellSig or buySig
    alert((sellSig ? "SELL" : "BUY") + " NY VWAP bounce on " + syminfo.ticker + " | Entry " + str.tostring(tEntry, format.mintick) + " | Stop " + str.tostring(tStop, format.mintick) + " | Target " + str.tostring(tTarget, format.mintick), alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────────────────────
// Confluence table
// ─────────────────────────────────────────────────────────────────────────────
f_pos(string p) =>
    switch p
        "Top Left"      => position.top_left
        "Top Right"     => position.top_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.bottom_right

f_size(string s) =>
    switch s
        "Tiny"  => size.tiny
        "Small" => size.small
        "Large" => size.large
        => size.normal

f_dotCol(int s) =>
    s > 0 ? bullCol : s < 0 ? bearCol : color.gray

f_orTxt(int s, bool done) =>
    not done ? "Forming" : s > 0 ? "Outside | ▲" : s < 0 ? "Outside | ▼" : "Inside"

var table tbl = table.new(f_pos(tblPos), 4, 7, bgcolor = color.new(#131722, 10), border_color = color.new(color.gray, 60), border_width = 1, frame_color = color.new(color.gray, 60), frame_width = 1)

f_short(string sym) =>
    array<string> parts = str.split(sym, ":")
    array.size(parts) > 0 ? array.last(parts) : sym

if barstate.isfirst
    table.merge_cells(tbl, 0, 6, 3, 6)

f_col(int c, string name, int sNy, int sOn, int sPd, int sOr, bool done, int trend, txtSize) =>
    color tc = color.new(color.white, 10)
    table.cell(tbl, c, 0, name, text_color = tc, text_size = txtSize)
    table.cell(tbl, c, 1, "●", text_color = f_dotCol(sNy), text_size = txtSize)
    table.cell(tbl, c, 2, "●", text_color = f_dotCol(sOn), text_size = txtSize)
    table.cell(tbl, c, 3, "●", text_color = f_dotCol(sPd), text_size = txtSize)
    table.cell(tbl, c, 4, f_orTxt(sOr, done), text_color = f_dotCol(sOr), text_size = txtSize)
    table.cell(tbl, c, 5, f_trendTxt(trend), text_color = f_dotCol(trend), text_size = txtSize)

if showTbl and barstate.islast
    ts = f_size(tblSize)
    color hc = color.new(color.white, 10)
    table.cell(tbl, 0, 0, "Ticker", text_color = hc, text_size = ts, text_halign = text.align_right)
    table.cell(tbl, 0, 1, "NY VWAP", text_color = hc, text_size = ts, text_halign = text.align_right)
    table.cell(tbl, 0, 2, "Overnight VWAP", text_color = hc, text_size = ts, text_halign = text.align_right)
    table.cell(tbl, 0, 3, "PD NY VWAP", text_color = hc, text_size = ts, text_halign = text.align_right)
    table.cell(tbl, 0, 4, "Opening Range", text_color = hc, text_size = ts, text_halign = text.align_right)
    table.cell(tbl, 0, 5, "Trend", text_color = hc, text_size = ts, text_halign = text.align_right)
    f_col(1, f_short(sym1), aNy, aOn, aPd, aOr, aOrDone, aTrend, ts)
    f_col(2, f_short(sym2), bNy, bOn, bPd, bOr, bOrDone, bTrend, ts)
    f_col(3, f_short(sym3), dNy, dOn, dPd, dOr, dOrDone, dTrend, ts)
    string stats = "Signals W/L: " + str.tostring(wins) + " / " + str.tostring(losses)
    if timeframe.in_seconds() > orMins * 60
        stats := "⚠ Use a chart timeframe ≤ " + str.tostring(orMins) + "m"
    table.cell(tbl, 0, 6, stats, text_color = color.gray, text_size = size.tiny, text_halign = text.align_left)
